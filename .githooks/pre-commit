#!/bin/sh
set -eu

ROOT=$(git rev-parse --show-toplevel)
if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "Git hygiene guard requires Python 3." >&2
    exit 1
fi

exec "$PYTHON" "$ROOT/scripts/check_git_file_sizes.py" staged
